          {
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "text",
                "text": "My role as a Art Director involves collaborating with the masthead team on informing the creative vision of the issue, designing and laying out spreads, creating merch for the launch events and helping with photoshoots as a production assistant. "
              }
            ]
          }
        ]
