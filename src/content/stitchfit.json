              {
                "type": "text",
                "text": "2"
              }
            ],
            "level": 2
          },
          {
            "type": "image",
            "src": "images/cards-5.jpg",
            "alt": ""
          }
        ]
      },
      {
        "type": "stack",
        "spacing": "normal",
        "children": [
          {
            "type": "richText",
            "role": "section",
            "content": [
              {
                "type": "text",
                "text": "Wireframes"
              }
            ],
            "level": 2
          },
          {
            "type": "stack",
            "spacing": "compact",
            "children": [
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "I translated the sketches into a clickable low-fidelity prototype. Three usability tests informed revisions before I developed the high-fidelity prototype."
                  }
                ]
              },
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "Some recommendations that users suggested were:"
                  }
                ]
              },
              {
                "type": "list",
                "ordered": true,
                "children": [
                  {
                    "type": "listItem",
                    "children": [
                      {
                        "type": "richText",
                        "role": "body",
                        "content": [
                          {
                            "type": "text",
                            "text": "Add a filter search option."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "children": [
                      {
                        "type": "richText",
                        "role": "body",
                        "content": [
                          {
                            "type": "text",
                            "text": "Make switching users more intuitive and easier to find."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "children": [
                      {
                        "type": "richText",
                        "role": "body",
                        "content": [
                          {
                            "type": "text",
                            "text": "Move the login to a later part of the app so that users are not asked to log in immediately after opening the app. "
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "image",
        "src": "images/cards-6.png",
        "alt": ""
      },
      {
        "type": "stack",
        "spacing": "normal",
        "children": [
          {
            "type": "richText",
            "role": "section",
            "content": [
              {
                "type": "text",
                "text": "Improving the onboarding process"
              }
            ],
            "level": 2
          },
          {
            "type": "stack",
            "spacing": "compact",
            "children": [
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "One challenge identified during usability testing was that users did not want to log in at the beginning of the set-up process. Allowing users to skip certain steps creates a more seamless and user-driven introduction to the app, enabling them to understand its functionality before signing up."
                  }
                ]
              },
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "Users will have three opportunities to skip the setup process: "
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "columns",
        "spacing": "section",
        "ratios": [
          100,
          100,
          100
        ],
        "children": [
          {
            "type": "card",
            "variant": "annotation",
            "children": [
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
