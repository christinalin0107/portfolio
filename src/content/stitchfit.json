            "alt": ""
          },
          {
            "type": "image",
            "src": "images/cards-3.png",
            "alt": ""
          }
        ]
      },
      {
        "type": "stack",
        "spacing": "normal",
        "children": [
          {
            "type": "richText",
            "role": "section",
            "content": [
              {
                "type": "text",
                "text": "Sketches"
              }
            ],
            "level": 2
          },
          {
            "type": "stack",
            "spacing": "compact",
            "children": [
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "Informed by the user research, I began designing low-fidelity sketches to determine the direction that I wanted to take my project and to brainstorm details that would be included in the final design."
                  }
                ]
              },
              {
                "type": "richText",
                "role": "body",
                "content": [
                  {
                    "type": "text",
                    "text": "I brainstormed two ideas for products that would solve the problem of inconsistent sizing online."
                  }
                ]
              },
              {
                "type": "list",
                "ordered": false,
                "children": [
                  {
                    "type": "listItem",
                    "children": [
                      {
                        "type": "richText",
                        "role": "body",
                        "content": [
                          {
                            "type": "text",
                            "text": "Sketch 1 is an app that utilizes photo scanning technology to determine a user's size, then suggests clothing based on their size"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "children": [
                      {
                        "type": "richText",
                        "role": "body",
                        "content": [
                          {
                            "type": "text",
                            "text": "Sketch 2 is a browser plug-in that asks users a variety of questions about their body, fit preferences, and sizing from specific brands"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "text",
                "text": "I chose Sketch 1 to explore whether photo-based measurements could reduce reliance on subjective sizing questions. That was a design hypothesis, not a validated accuracy improvement; the prototype focused on how people would understand and use the proposed flow."
              }
            ]
          }
        ]
      },
      {
        "type": "columns",
        "spacing": "normal",
        "ratios": [
          100,
          100,
          100,
          100
        ],
        "children": [
          {
            "type": "richText",
            "role": "subsection",
            "content": [
              {
                "type": "text",
                "text": "1"
              }
            ],
            "level": 2
          },
          {
            "type": "image",
            "src": "images/cards-4.jpg",
            "alt": ""
          },
          {
            "type": "richText",
            "role": "subsection",
